{
  "name": "biocode",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "next build",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:sql": "tsx scripts/check-sql.ts",
    "db:diff": "supabase db push --linked --dry-run",
    "db:link": "supabase link --project-ref rszbpdgfvyofvmuishmn",
    "db:push": "supabase db push --linked",
    "db:reset": "supabase db reset",
    "db:seed:linked": "supabase db push --linked --include-seed",
    "db:types": "tsx scripts/gen-types.ts --local",
    "db:types:linked": "tsx scripts/gen-types.ts --linked",
    "dev": "next dev",
    "email:test": "tsx scripts/send-test-email.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "measure:bundle": "tsx scripts/measure-bundle.ts",
    "purge:demo": "tsx scripts/purge-demo-catalogue.ts",
    "purge:test-data": "tsx scripts/purge-test-data.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:images": "tsx scripts/seed-images.ts",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check:i18n && pnpm check:sql && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:bundle",
    "fix:image-cache": "tsx scripts/fix-image-cache.ts",
    "measure:vitals": "tsx scripts/measure-vitals.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.5.7",
    "@paulmillr/qr": "^0.3.0",
    "@sentry/nextjs": "10.69.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.28.0",
    "motion": "12.43.0",
    "next": "15.5.22",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.110.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.3"
    }
  }
}
