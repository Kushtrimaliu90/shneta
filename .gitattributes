# Normalise to LF in the repository regardless of the contributor's OS, so CI (Linux)
# and Windows checkouts never differ and diffs stay clean.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff  binary
*.woff2 binary

pnpm-lock.yaml -diff linguist-generated
src/lib/supabase/database.types.ts linguist-generated
