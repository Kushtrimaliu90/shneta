# BIOCODE — environment (docs/10 §3)
# Copy to .env.local for development.  Never commit a real .env (CLAUDE.md "Do NOT").
#
# The values below are the defaults printed by `supabase start`, so a fresh clone runs
# against the local stack without editing anything. Staging and prod values live in Vercel.

# --- Required from M0 --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://biocode.fit
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
EMAIL_FROM="BIOCODE <porosite@biocode.fit>"

# Server only — never prefix with NEXT_PUBLIC, never log. Bypasses RLS entirely,
# so its callers are the closed list in docs/02 §6.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Destructive-test opt-in --------------------------------------------------
# The integration and E2E suites create and delete brands, products, stock, carts, orders,
# refunds and auth users. They REFUSE TO RUN unless this matches the project ref in
# NEXT_PUBLIC_SUPABASE_URL — absence means "not a test database", never "probably fine".
#
# Local development needs nothing here: 127.0.0.1 is exempt, because `supabase db reset`
# recreates it by definition.
#
# ⚠ NEVER set this in Vercel, and REMOVE IT from .env.local the day the project it names
#   starts holding real orders. This variable is the only thing standing between
#   `pnpm test:e2e` and a customer's data. See docs/14 §7.
# SUPABASE_TEST_PROJECT=

# --- Hosted dev project -------------------------------------------------------
# To run against the hosted Supabase instead of the local stack, put these in
# .env.local (never here — this file is committed). Keys: dashboard → Settings → API.
# See runbooks/supabase-setup.md for the full procedure.
#
#   NEXT_PUBLIC_SUPABASE_URL=https://rszbpdgfvyofvmuishmn.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# --- Transactional email (Resend) --------------------------------------------
# biocode.fit is registered and verified in Resend (SPF/DKIM/DMARC). The From: domain must
# be that one, not the brand name — mail from an unverified domain lands in spam.
#
# Both of these are required for anything to actually send. Without them `sendEmail` records
# `skipped_no_provider` in `email_log` and returns cleanly, so the shop keeps working and
# nobody receives anything (src/lib/email/send.ts).
#
# The quotes below are required **in this file** — the value contains spaces and angle brackets,
# and dotenv strips the wrapping pair when it reads it. In a hosting dashboard (Vercel → Settings
# → Environment Variables) there is no dotenv and no parsing: paste the address exactly as
#
#     BIOCODE <porosite@biocode.fit>
#
# Adding quotes there sends them to the provider as part of the address, and Resend answers
# `422 Invalid `from` field` — verified, and the same mistake once broke `pnpm email:test`
# (docs/13 §V1).
RESEND_API_KEY=
EMAIL_FROM="BIOCODE <porosite@biocode.fit>"

# --- M9+ · cron and on-demand revalidation -----------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically when this is set.
# CRON_SECRET=
# REVALIDATE_SECRET=

# --- Observability ------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Post-v1 · bank virtual POS (docs/07 §6.3) -------------------------------
# BANK_POS_MERCHANT_ID=
# BANK_POS_SECRET=
# BANK_POS_BASE_URL=

# --- Optional · Upstash rate limiter -----------------------------------------
# Leave unset to use the Postgres limiter, which is the chosen default (docs/02 §9).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# docs/10 §5 — CSP is report-only until this is set. Flip to `true` after a week of clean
# reports; roll back by unsetting it and redeploying. The enforced policy allows inline script
# because Next requires it (docs/13 §Q3); the strict version ships as report-only alongside.
# CSP_ENFORCE=true

# Search-engine indexing. Defaults to "off": robots.txt returns Disallow: / and every response
# carries X-Robots-Tag: noindex. Set to "on" at launch, once products have photographs and the
# legal pages have real trader details. See docs/14 §20 item 2b and docs/13 §AC.
SEO_INDEXING=off

# Social sign-in (docs/05 §15). 'true' only once Supabase -> Auth -> Providers -> Google
# holds a real client ID and secret; the button is hidden entirely while this is unset, so the
# code can ship before the credentials do.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
