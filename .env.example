# SHNETA — environment (docs/10 §3)
# Copy to .env.local for development.  Never commit a real .env (CLAUDE.md "Do NOT").
#
# The values below are the defaults printed by `supabase start`, so a fresh clone runs
# against the local stack without editing anything. Staging and prod values live in Vercel.

# --- Required from M0 --------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server only — never prefix with NEXT_PUBLIC, never log.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- M4+ · transactional email (Resend) --------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM="SHNETA <porosite@shneta.com>"

# --- M9+ · cron and on-demand revalidation -----------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically when this is set.
# CRON_SECRET=
# REVALIDATE_SECRET=

# --- Observability ------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Post-v1 · bank virtual POS (docs/07 §6.3) -------------------------------
# BANK_POS_MERCHANT_ID=
# BANK_POS_SECRET=
# BANK_POS_BASE_URL=

# --- Optional · Upstash rate limiter -----------------------------------------
# Leave unset to use the Postgres limiter, which is the chosen default (docs/02 §9).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
